root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,S,s,lds}]
indent_style = tab
indent_size = 8
tab_width = 8

[Makefile]
indent_style = tab
indent_size = 8
tab_width = 8

[Makefile.*]
indent_style = tab
indent_size = 8
tab_width = 8

[*.{md,txt}]
trim_trailing_whitespace = false
indent_style = space
indent_size = 4
